import "src/prs/arbiter_2_prs.act";

// Two levels of arbiter_2_prs: identical tree structure to the CHP version.

template <pint MESH_LENGTH, DATA_WIDTH>
defproc arbiter_4_prs (
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in1;
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in2;
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in3;
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in4;

    pkt_chan!<MESH_LENGTH, DATA_WIDTH> out
)
{
    pkt_chan<MESH_LENGTH, DATA_WIDTH> mid1, mid2;

    arbiter_2_prs<MESH_LENGTH, DATA_WIDTH> arb_top  (in1, in2, mid1);
    arbiter_2_prs<MESH_LENGTH, DATA_WIDTH> arb_bot  (in3, in4, mid2);
    arbiter_2_prs<MESH_LENGTH, DATA_WIDTH> arb_final(mid1, mid2, out);
}
