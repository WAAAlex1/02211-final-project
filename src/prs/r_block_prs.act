import "src/prs/types.act";

// 2-phase bundled-data routing block - written after Dally's super-simple async router.
//
// Packet bit layout (MSB to LSB):
//   [W-1 .. ML+2+DW]   x_dest  (MESH_LENGTH bits)
//   [ML+1+DW .. 2+DW]  y_dest  (MESH_LENGTH bits)
//   [1+DW]             x_dir   (1 = east/positive, 0 = west/negative)
//   [DW]               y_dir   (1 = north/positive, 0 = south/negative)
//   [DW-1 .. 0]        payload (DATA_WIDTH bits)
//

template <pint MESH_LENGTH, DATA_WIDTH, X_COORD, Y_COORD>
defproc r_block_prs (
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in_chan;
    pkt_chan!<MESH_LENGTH, DATA_WIDTH> out_N, out_S, out_E, out_W, out_L
)
{
    pint W = 2*MESH_LENGTH + 2 + DATA_WIDTH;

    // Internals
    bool x_match[MESH_LENGTH];  // per-bit: x_dest[j] == X_COORD[j]?
    bool y_match[MESH_LENGTH];
    bool x_eq, y_eq;            // x_eq = AND of x_match; y_eq = AND of y_match

    // State
    bool pending;                              // Request pending ack
    bool sel_N, sel_S, sel_E, sel_W, sel_L;    // RS-latch outputs

    // ================================================================
    // [R BLOCK] - Equality comparator: first AND layer
    //
    // For each bit j, x_match[j] is HIGH when in_chan.d[offset+j] equals
    // the compile-time constant X_COORD bit j (XNOR).
    //
    // ================================================================

    // --- First AND layer (x): x_dest bits [W-1 .. ML+2+DW] vs X_COORD ---
    ( j : MESH_LENGTH :
        [ (X_COORD >> j) % 2 = 1 ->
            prs { ~in_chan.d[MESH_LENGTH + 2 + DATA_WIDTH + j] => x_match[j]- }
        [] else ->
            prs {  in_chan.d[MESH_LENGTH + 2 + DATA_WIDTH + j] => x_match[j]- }
        ]
    )

    // --- First AND layer (y): y_dest bits [ML+1+DW .. 2+DW] vs Y_COORD ---
    ( j : MESH_LENGTH :
        [ (Y_COORD >> j) % 2 = 1 ->
            prs { ~in_chan.d[2 + DATA_WIDTH + j] => y_match[j]- }
        [] else ->
            prs {  in_chan.d[2 + DATA_WIDTH + j] => y_match[j]- }
        ]
    )

    prs {

    // --- Aggregate AND of match bits to get x_eq and y_eq ---

        (& j : MESH_LENGTH : x_match[j]) => x_eq+
        (& j : MESH_LENGTH : y_match[j]) => y_eq+

    // ================================================================
    // [I BLOCK] - Pending detection (r XOR a)
    //
    // pending = 1 while the input handshake is in progress.
    // Gates the sel latches and makes sure that
    // a routing decision is only made when a real request is present.
    // ================================================================

        (in_chan.r & ~in_chan.a) | (~in_chan.r & in_chan.a) => pending+     // simple xor gate

    // ================================================================
    // [R BLOCK] - Second AND layer: Direction select
    //
    // x_eq, y_eq, and the packet direction bits (d[1+DW], d[DW]) are ANDed
    // directly to produce the five mutually exclusive select signals.
    // ================================================================

        pending &  x_eq &  y_eq                          -> sel_L+          // We have arrived at the end router
        pending & ~x_eq &  in_chan.d[1 + DATA_WIDTH]     -> sel_E+          // We need to move horizontally right
        pending & ~x_eq & ~in_chan.d[1 + DATA_WIDTH]     -> sel_W+          // We need to move horizontally left
        pending &  x_eq & ~y_eq &  in_chan.d[DATA_WIDTH] -> sel_N+          // X is correct, y is not. Move up.
        pending &  x_eq & ~y_eq & ~in_chan.d[DATA_WIDTH] -> sel_S+          // X is correct, y is not. Move down.

    // ================================================================
    // [A BLOCK] - RS-latches
    //
    // Each sel signal is an SR latch:
    //   S (set)   = keep sels from above
    //   R (reset) = input handshake complete (r == a, not pending)
    // ================================================================

        ~pending -> sel_L-
        ~pending -> sel_E-
        ~pending -> sel_W-
        ~pending -> sel_N-
        ~pending -> sel_S-

    // ================================================================
    // [A BLOCK] - Data mux + 2-phase output request
    //
    // The active sel latches guides the input data through to the correct output.
    // Keepers hold the output request wire between handshakes.
    //
    // For-loop needed for multi-bit channels.
    //
    // ================================================================

    // ---- Local ----

        ( i : W :
            sel_L &  in_chan.d[i] -> out_L.d[i]+
            sel_L & ~in_chan.d[i] -> out_L.d[i]-
           ~sel_L                 -> out_L.d[i]-
        )
        sel_L & ~out_L.r & ~out_L.a -> out_L.r+
        sel_L &  out_L.r &  out_L.a -> out_L.r-
        [iskeeper=1]  out_L.r -> out_L.r+
        [iskeeper=1] ~out_L.r -> out_L.r-

    // ---- North ----

        ( i : W :
            sel_N &  in_chan.d[i] -> out_N.d[i]+
            sel_N & ~in_chan.d[i] -> out_N.d[i]-
           ~sel_N                 -> out_N.d[i]-
        )
        sel_N & ~out_N.r & ~out_N.a -> out_N.r+
        sel_N &  out_N.r &  out_N.a -> out_N.r-
        [iskeeper=1]  out_N.r -> out_N.r+
        [iskeeper=1] ~out_N.r -> out_N.r-

    // ---- South ----

        ( i : W :
            sel_S &  in_chan.d[i] -> out_S.d[i]+
            sel_S & ~in_chan.d[i] -> out_S.d[i]-
           ~sel_S                 -> out_S.d[i]-
        )
        sel_S & ~out_S.r & ~out_S.a -> out_S.r+
        sel_S &  out_S.r &  out_S.a -> out_S.r-
        [iskeeper=1]  out_S.r -> out_S.r+
        [iskeeper=1] ~out_S.r -> out_S.r-

    // ---- East ----

        ( i : W :
            sel_E &  in_chan.d[i] -> out_E.d[i]+
            sel_E & ~in_chan.d[i] -> out_E.d[i]-
           ~sel_E                 -> out_E.d[i]-
        )
        sel_E & ~out_E.r & ~out_E.a -> out_E.r+
        sel_E &  out_E.r &  out_E.a -> out_E.r-
        [iskeeper=1]  out_E.r -> out_E.r+
        [iskeeper=1] ~out_E.r -> out_E.r-

    // ---- West ----

        ( i : W :
            sel_W &  in_chan.d[i] -> out_W.d[i]+
            sel_W & ~in_chan.d[i] -> out_W.d[i]-
           ~sel_W                 -> out_W.d[i]-
        )
        sel_W & ~out_W.r & ~out_W.a -> out_W.r+
        sel_W &  out_W.r &  out_W.a -> out_W.r-
        [iskeeper=1]  out_W.r -> out_W.r+
        [iskeeper=1] ~out_W.r -> out_W.r-

    // ================================================================
    // [I BLOCK] - input acknowledge
    //
    // Drives in_chan.a after the selected output has acknowledged.
    //
    // Both the request arrival (in the form of sel) and output ack (out_X.a)
    // must complete before in_chan.a is toggled.
    //
    // Keeper holds in_chan.a between handshakes.
    // ================================================================

        sel_L &  out_L.a -> in_chan.a+
        sel_L & ~out_L.a -> in_chan.a-
        sel_N &  out_N.a -> in_chan.a+
        sel_N & ~out_N.a -> in_chan.a-
        sel_S &  out_S.a -> in_chan.a+
        sel_S & ~out_S.a -> in_chan.a-
        sel_E &  out_E.a -> in_chan.a+
        sel_E & ~out_E.a -> in_chan.a-
        sel_W &  out_W.a -> in_chan.a+
        sel_W & ~out_W.a -> in_chan.a-
        [iskeeper=1]  in_chan.a -> in_chan.a+
        [iskeeper=1] ~in_chan.a -> in_chan.a-

    }
}
