import "src/prs/types.act";
import "std/arb.act";
import globals;

// 2-phase arbiter (2 inputs -> 1 output).

template <pint MESH_LENGTH, DATA_WIDTH>
defproc arbiter_2_prs (
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in1;
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in2;
    pkt_chan!<MESH_LENGTH, DATA_WIDTH> out
)
{
    pint W = 2*MESH_LENGTH + 2 + DATA_WIDTH;

    bool pending1, pending2;
    bool g1, g2;

    // Classic Seitz arbiter - resolves metastability. Uses two cross-coupled NAND gates. 
    std::buf_arbiter mutex(pending1, pending2, g1, g2); 

    prs {
        // Pending detection: r XOR a (transaction in flight on input i).
        ~Reset & ((in1.r & ~in1.a) | (~in1.r & in1.a)) => pending1+
        ~Reset & ((in2.r & ~in2.a) | (~in2.r & in2.a)) => pending2+

        // Data mux: out.d tracks the granted input's d, holds otherwise.
        ( i : W :
            ~Reset & ( (g1 & in1.d[i]) | (g2 & in2.d[i])
                     | (~g1 & ~g2 & out.d[i]) ) => out.d[i]+
        )

        // Output request: out.r = T1 XOR T2, T_i = (g_i ? in_i.r : in_i.a).
        // [after=30] is the bundled-data matched delay: data and request fire
        // off the same grant edge in parallel, so we hold the request back
        [after=20] ~Reset & (
            (((g1 & in1.r) | (~g1 & in1.a)) & ~((g2 & in2.r) | (~g2 & in2.a)))   
            | (~((g1 & in1.r) | (~g1 & in1.a)) & ((g2 & in2.r) | (~g2 & in2.a)))
            ) => out.r+

        // Input ack: in_i.a = (out.a XOR in_other.a) while granted, else hold.
        ~Reset & (
            ( g1 & ( (out.a & ~in2.a) | (~out.a & in2.a) ) ) | ( ~g1 & in1.a )
            ) => in1.a+
        ~Reset & (
            ( g2 & ( (out.a & ~in1.a) | (~out.a & in1.a) ) ) | ( ~g2 & in2.a )
            ) => in2.a+
    }
}
