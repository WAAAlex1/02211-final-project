import "src/chp/route_sink.act";

template <pint PORT_X, PORT_Y>
defproc mock_core_rx (chan?(int<14>) in_chan) {
    int<14> pkt;
    chp {
        *[
            in_chan?pkt;
            log(" [EJECT] Core at (", PORT_X, ",", PORT_Y, ") received Payload: ", pkt{7..0})
        ]
    }
}

defproc mock_core_tx_0_0 (chan?(int<1>) trigger; chan!(int<14>) out_chan) {
    int<1> t;
    chp {
        trigger?t;
        log(" [INJECT] from (0,0) to (0,1) payload=243");
        out_chan!1267;
        log(" [INJECT] from (0,0) to (1,2) payload=160");
        out_chan!6304;
        log(" [INJECT] from (0,0) to (2,1) payload=163");
        out_chan!9379;
        log(" [INJECT] from (0,0) to (1,2) payload=227");
        out_chan!6371;
        log(" [INJECT] from (0,0) to (2,1) payload=97");
        out_chan!9313
    }
}

