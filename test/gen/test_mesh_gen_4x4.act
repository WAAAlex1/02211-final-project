    route_sink<2, 8> sk_s_3(out_3_0_s);
    route_sink<2, 8> sk_n_3(out_3_3_n);
    route_sink<2, 8> sk_w_0(out_0_0_w);
    route_sink<2, 8> sk_e_0(out_3_0_e);
    route_sink<2, 8> sk_w_1(out_0_1_w);
    route_sink<2, 8> sk_e_1(out_3_1_e);
    route_sink<2, 8> sk_w_2(out_0_2_w);
    route_sink<2, 8> sk_e_2(out_3_2_e);
    route_sink<2, 8> sk_w_3(out_0_3_w);
    route_sink<2, 8> sk_e_3(out_3_3_e);

    chp {
        log("--- STARTING MESH SIMULATION ---");
        t_0_0!1,
        t_1_0!1,
        t_2_0!1,
        t_3_0!1,
        t_0_1!1,
