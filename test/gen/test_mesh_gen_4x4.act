defproc test_mesh () {
    chan(int<1>) t_0_0;
    chan(int<14>) core_to_ni_0_0, ni_to_core_0_0;
    chan(int<1>) t_1_0;
    chan(int<14>) core_to_ni_1_0, ni_to_core_1_0;
    chan(int<1>) t_2_0;
    chan(int<14>) core_to_ni_2_0, ni_to_core_2_0;
    chan(int<1>) t_3_0;
    chan(int<14>) core_to_ni_3_0, ni_to_core_3_0;
    chan(int<1>) t_0_1;
    chan(int<14>) core_to_ni_0_1, ni_to_core_0_1;
    chan(int<1>) t_1_1;
    chan(int<14>) core_to_ni_1_1, ni_to_core_1_1;
    chan(int<1>) t_2_1;
    chan(int<14>) core_to_ni_2_1, ni_to_core_2_1;
    chan(int<1>) t_3_1;
    chan(int<14>) core_to_ni_3_1, ni_to_core_3_1;
    chan(int<1>) t_0_2;
    chan(int<14>) core_to_ni_0_2, ni_to_core_0_2;
    chan(int<1>) t_1_2;
    chan(int<14>) core_to_ni_1_2, ni_to_core_1_2;
    chan(int<1>) t_2_2;
    chan(int<14>) core_to_ni_2_2, ni_to_core_2_2;
    chan(int<1>) t_3_2;
    chan(int<14>) core_to_ni_3_2, ni_to_core_3_2;
    chan(int<1>) t_0_3;
    chan(int<14>) core_to_ni_0_3, ni_to_core_0_3;
    chan(int<1>) t_1_3;
    chan(int<14>) core_to_ni_1_3, ni_to_core_1_3;
    chan(int<1>) t_2_3;
    chan(int<14>) core_to_ni_2_3, ni_to_core_2_3;
    chan(int<1>) t_3_3;
    chan(int<14>) core_to_ni_3_3, ni_to_core_3_3;

    chan(int<14>) ni_to_r_0_0, r_to_ni_0_0;
    chan(int<14>) ni_to_r_1_0, r_to_ni_1_0;
    chan(int<14>) ni_to_r_2_0, r_to_ni_2_0;
    chan(int<14>) ni_to_r_3_0, r_to_ni_3_0;
    chan(int<14>) ni_to_r_0_1, r_to_ni_0_1;
    chan(int<14>) ni_to_r_1_1, r_to_ni_1_1;
    chan(int<14>) ni_to_r_2_1, r_to_ni_2_1;
    chan(int<14>) ni_to_r_3_1, r_to_ni_3_1;
    chan(int<14>) ni_to_r_0_2, r_to_ni_0_2;
    chan(int<14>) ni_to_r_1_2, r_to_ni_1_2;
    chan(int<14>) ni_to_r_2_2, r_to_ni_2_2;
    chan(int<14>) ni_to_r_3_2, r_to_ni_3_2;
    chan(int<14>) ni_to_r_0_3, r_to_ni_0_3;
    chan(int<14>) ni_to_r_1_3, r_to_ni_1_3;
    chan(int<14>) ni_to_r_2_3, r_to_ni_2_3;
    chan(int<14>) ni_to_r_3_3, r_to_ni_3_3;

    chan(int<14>) e_0_0_to_1_0, w_1_0_to_0_0;
    chan(int<14>) e_1_0_to_2_0, w_2_0_to_1_0;
    chan(int<14>) e_2_0_to_3_0, w_3_0_to_2_0;
    chan(int<14>) e_0_1_to_1_1, w_1_1_to_0_1;
    chan(int<14>) e_1_1_to_2_1, w_2_1_to_1_1;
    chan(int<14>) e_2_1_to_3_1, w_3_1_to_2_1;
    chan(int<14>) e_0_2_to_1_2, w_1_2_to_0_2;
    chan(int<14>) e_1_2_to_2_2, w_2_2_to_1_2;
    chan(int<14>) e_2_2_to_3_2, w_3_2_to_2_2;
    chan(int<14>) e_0_3_to_1_3, w_1_3_to_0_3;
    chan(int<14>) e_1_3_to_2_3, w_2_3_to_1_3;
    chan(int<14>) e_2_3_to_3_3, w_3_3_to_2_3;
    chan(int<14>) n_0_0_to_0_1, s_0_1_to_0_0;
    chan(int<14>) n_0_1_to_0_2, s_0_2_to_0_1;
    chan(int<14>) n_0_2_to_0_3, s_0_3_to_0_2;
    chan(int<14>) n_1_0_to_1_1, s_1_1_to_1_0;
    chan(int<14>) n_1_1_to_1_2, s_1_2_to_1_1;
    chan(int<14>) n_1_2_to_1_3, s_1_3_to_1_2;
    chan(int<14>) n_2_0_to_2_1, s_2_1_to_2_0;
    chan(int<14>) n_2_1_to_2_2, s_2_2_to_2_1;
    chan(int<14>) n_2_2_to_2_3, s_2_3_to_2_2;
    chan(int<14>) n_3_0_to_3_1, s_3_1_to_3_0;
    chan(int<14>) n_3_1_to_3_2, s_3_2_to_3_1;
    chan(int<14>) n_3_2_to_3_3, s_3_3_to_3_2;

    chan(int<14>) in_0_0_s, out_0_0_s; // Bottom Edge S
    chan(int<14>) in_0_3_n, out_0_3_n; // Top Edge N
    chan(int<14>) in_1_0_s, out_1_0_s; // Bottom Edge S
    chan(int<14>) in_1_3_n, out_1_3_n; // Top Edge N
    chan(int<14>) in_2_0_s, out_2_0_s; // Bottom Edge S
    chan(int<14>) in_2_3_n, out_2_3_n; // Top Edge N
    chan(int<14>) in_3_0_s, out_3_0_s; // Bottom Edge S
    chan(int<14>) in_3_3_n, out_3_3_n; // Top Edge N
    chan(int<14>) in_0_0_w, out_0_0_w; // Left Edge W
    chan(int<14>) in_3_0_e, out_3_0_e; // Right Edge E
    chan(int<14>) in_0_1_w, out_0_1_w; // Left Edge W
    chan(int<14>) in_3_1_e, out_3_1_e; // Right Edge E
    chan(int<14>) in_0_2_w, out_0_2_w; // Left Edge W
    chan(int<14>) in_3_2_e, out_3_2_e; // Right Edge E
    chan(int<14>) in_0_3_w, out_0_3_w; // Left Edge W
    chan(int<14>) in_3_3_e, out_3_3_e; // Right Edge E

    mock_core_tx_0_0 core_tx_0_0(t_0_0, core_to_ni_0_0);
    mock_core_rx<0, 0> core_rx_0_0(ni_to_core_0_0);
    network_interface<2, 8, 0, 0> ni_0_0(core_to_ni_0_0, ni_to_r_0_0, r_to_ni_0_0, ni_to_core_0_0);
    router<2, 8, 0, 0> r_0_0(
        w_1_0_to_0_0, in_0_0_w, s_0_1_to_0_0, in_0_0_s, ni_to_r_0_0,
        e_0_0_to_1_0, out_0_0_w, n_0_0_to_0_1, out_0_0_s, r_to_ni_0_0
    );

    mock_core_tx_1_0 core_tx_1_0(t_1_0, core_to_ni_1_0);
    mock_core_rx<1, 0> core_rx_1_0(ni_to_core_1_0);
    network_interface<2, 8, 1, 0> ni_1_0(core_to_ni_1_0, ni_to_r_1_0, r_to_ni_1_0, ni_to_core_1_0);
    router<2, 8, 1, 0> r_1_0(
        w_2_0_to_1_0, e_0_0_to_1_0, s_1_1_to_1_0, in_1_0_s, ni_to_r_1_0,
        e_1_0_to_2_0, w_1_0_to_0_0, n_1_0_to_1_1, out_1_0_s, r_to_ni_1_0
    );

    mock_core_tx_2_0 core_tx_2_0(t_2_0, core_to_ni_2_0);
    mock_core_rx<2, 0> core_rx_2_0(ni_to_core_2_0);
    network_interface<2, 8, 2, 0> ni_2_0(core_to_ni_2_0, ni_to_r_2_0, r_to_ni_2_0, ni_to_core_2_0);
    router<2, 8, 2, 0> r_2_0(
        w_3_0_to_2_0, e_1_0_to_2_0, s_2_1_to_2_0, in_2_0_s, ni_to_r_2_0,
        e_2_0_to_3_0, w_2_0_to_1_0, n_2_0_to_2_1, out_2_0_s, r_to_ni_2_0
    );

    mock_core_tx_3_0 core_tx_3_0(t_3_0, core_to_ni_3_0);
    mock_core_rx<3, 0> core_rx_3_0(ni_to_core_3_0);
    network_interface<2, 8, 3, 0> ni_3_0(core_to_ni_3_0, ni_to_r_3_0, r_to_ni_3_0, ni_to_core_3_0);
    router<2, 8, 3, 0> r_3_0(
        in_3_0_e, e_2_0_to_3_0, s_3_1_to_3_0, in_3_0_s, ni_to_r_3_0,
        out_3_0_e, w_3_0_to_2_0, n_3_0_to_3_1, out_3_0_s, r_to_ni_3_0
    );

    mock_core_tx_0_1 core_tx_0_1(t_0_1, core_to_ni_0_1);
    mock_core_rx<0, 1> core_rx_0_1(ni_to_core_0_1);
    network_interface<2, 8, 0, 1> ni_0_1(core_to_ni_0_1, ni_to_r_0_1, r_to_ni_0_1, ni_to_core_0_1);
    router<2, 8, 0, 1> r_0_1(
        w_1_1_to_0_1, in_0_1_w, s_0_2_to_0_1, n_0_0_to_0_1, ni_to_r_0_1,
        e_0_1_to_1_1, out_0_1_w, n_0_1_to_0_2, s_0_1_to_0_0, r_to_ni_0_1
    );

    mock_core_tx_1_1 core_tx_1_1(t_1_1, core_to_ni_1_1);
    mock_core_rx<1, 1> core_rx_1_1(ni_to_core_1_1);
    network_interface<2, 8, 1, 1> ni_1_1(core_to_ni_1_1, ni_to_r_1_1, r_to_ni_1_1, ni_to_core_1_1);
    router<2, 8, 1, 1> r_1_1(
        w_2_1_to_1_1, e_0_1_to_1_1, s_1_2_to_1_1, n_1_0_to_1_1, ni_to_r_1_1,
        e_1_1_to_2_1, w_1_1_to_0_1, n_1_1_to_1_2, s_1_1_to_1_0, r_to_ni_1_1
    );

    mock_core_tx_2_1 core_tx_2_1(t_2_1, core_to_ni_2_1);
    mock_core_rx<2, 1> core_rx_2_1(ni_to_core_2_1);
    network_interface<2, 8, 2, 1> ni_2_1(core_to_ni_2_1, ni_to_r_2_1, r_to_ni_2_1, ni_to_core_2_1);
    router<2, 8, 2, 1> r_2_1(
