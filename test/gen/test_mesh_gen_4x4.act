    route_sink<2, 8> sk_s_0(out_0_0_s);
    route_sink<2, 8> sk_n_0(out_0_3_n);
    route_sink<2, 8> sk_s_1(out_1_0_s);
    route_sink<2, 8> sk_n_1(out_1_3_n);
    route_sink<2, 8> sk_s_2(out_2_0_s);
