    router_prs<2, 8, 1, 0> r_1_0(
        s_1_1_to_1_0, in_1_0_s, w_2_0_to_1_0, e_0_0_to_1_0, ni_to_r_1_0,
        n_1_0_to_1_1, out_1_0_s, e_1_0_to_2_0, w_1_0_to_0_0, r_to_ni_1_0
    );

    mock_core_tx_2_0 core_tx_2_0(t_2_0, core_to_ni_2_0);
    mock_core_rx<2, 0> core_rx_2_0(ni_to_core_2_0);
    network_interface_prs<2, 8, 2, 0> ni_2_0(core_to_ni_2_0, ni_to_r_2_0, r_to_ni_2_0, ni_to_core_2_0);
    router_prs<2, 8, 2, 0> r_2_0(
        s_2_1_to_2_0, in_2_0_s, w_3_0_to_2_0, e_1_0_to_2_0, ni_to_r_2_0,
        n_2_0_to_2_1, out_2_0_s, e_2_0_to_3_0, w_2_0_to_1_0, r_to_ni_2_0
    );

    mock_core_tx_3_0 core_tx_3_0(t_3_0, core_to_ni_3_0);
    mock_core_rx<3, 0> core_rx_3_0(ni_to_core_3_0);
    network_interface_prs<2, 8, 3, 0> ni_3_0(core_to_ni_3_0, ni_to_r_3_0, r_to_ni_3_0, ni_to_core_3_0);
    router_prs<2, 8, 3, 0> r_3_0(
        s_3_1_to_3_0, in_3_0_s, in_3_0_e, e_2_0_to_3_0, ni_to_r_3_0,
        n_3_0_to_3_1, out_3_0_s, out_3_0_e, w_3_0_to_2_0, r_to_ni_3_0
    );

    mock_core_tx_0_1 core_tx_0_1(t_0_1, core_to_ni_0_1);
    mock_core_rx<0, 1> core_rx_0_1(ni_to_core_0_1);
    network_interface_prs<2, 8, 0, 1> ni_0_1(core_to_ni_0_1, ni_to_r_0_1, r_to_ni_0_1, ni_to_core_0_1);
    router_prs<2, 8, 0, 1> r_0_1(
        s_0_2_to_0_1, n_0_0_to_0_1, w_1_1_to_0_1, in_0_1_w, ni_to_r_0_1,
        n_0_1_to_0_2, s_0_1_to_0_0, e_0_1_to_1_1, out_0_1_w, r_to_ni_0_1
    );

    mock_core_tx_1_1 core_tx_1_1(t_1_1, core_to_ni_1_1);
    mock_core_rx<1, 1> core_rx_1_1(ni_to_core_1_1);
    network_interface_prs<2, 8, 1, 1> ni_1_1(core_to_ni_1_1, ni_to_r_1_1, r_to_ni_1_1, ni_to_core_1_1);
    router_prs<2, 8, 1, 1> r_1_1(
        s_1_2_to_1_1, n_1_0_to_1_1, w_2_1_to_1_1, e_0_1_to_1_1, ni_to_r_1_1,
        n_1_1_to_1_2, s_1_1_to_1_0, e_1_1_to_2_1, w_1_1_to_0_1, r_to_ni_1_1
    );

    mock_core_tx_2_1 core_tx_2_1(t_2_1, core_to_ni_2_1);
    mock_core_rx<2, 1> core_rx_2_1(ni_to_core_2_1);
    network_interface_prs<2, 8, 2, 1> ni_2_1(core_to_ni_2_1, ni_to_r_2_1, r_to_ni_2_1, ni_to_core_2_1);
    router_prs<2, 8, 2, 1> r_2_1(
        s_2_2_to_2_1, n_2_0_to_2_1, w_3_1_to_2_1, e_1_1_to_2_1, ni_to_r_2_1,
        n_2_1_to_2_2, s_2_1_to_2_0, e_2_1_to_3_1, w_2_1_to_1_1, r_to_ni_2_1
    );

    mock_core_tx_3_1 core_tx_3_1(t_3_1, core_to_ni_3_1);
    mock_core_rx<3, 1> core_rx_3_1(ni_to_core_3_1);
    network_interface_prs<2, 8, 3, 1> ni_3_1(core_to_ni_3_1, ni_to_r_3_1, r_to_ni_3_1, ni_to_core_3_1);
    router_prs<2, 8, 3, 1> r_3_1(
        s_3_2_to_3_1, n_3_0_to_3_1, in_3_1_e, e_2_1_to_3_1, ni_to_r_3_1,
        n_3_1_to_3_2, s_3_1_to_3_0, out_3_1_e, w_3_1_to_2_1, r_to_ni_3_1
    );

    mock_core_tx_0_2 core_tx_0_2(t_0_2, core_to_ni_0_2);
    mock_core_rx<0, 2> core_rx_0_2(ni_to_core_0_2);
    network_interface_prs<2, 8, 0, 2> ni_0_2(core_to_ni_0_2, ni_to_r_0_2, r_to_ni_0_2, ni_to_core_0_2);
    router_prs<2, 8, 0, 2> r_0_2(
        s_0_3_to_0_2, n_0_1_to_0_2, w_1_2_to_0_2, in_0_2_w, ni_to_r_0_2,
        n_0_2_to_0_3, s_0_2_to_0_1, e_0_2_to_1_2, out_0_2_w, r_to_ni_0_2
    );

    mock_core_tx_1_2 core_tx_1_2(t_1_2, core_to_ni_1_2);
    mock_core_rx<1, 2> core_rx_1_2(ni_to_core_1_2);
    network_interface_prs<2, 8, 1, 2> ni_1_2(core_to_ni_1_2, ni_to_r_1_2, r_to_ni_1_2, ni_to_core_1_2);
    router_prs<2, 8, 1, 2> r_1_2(
        s_1_3_to_1_2, n_1_1_to_1_2, w_2_2_to_1_2, e_0_2_to_1_2, ni_to_r_1_2,
        n_1_2_to_1_3, s_1_2_to_1_1, e_1_2_to_2_2, w_1_2_to_0_2, r_to_ni_1_2
    );

    mock_core_tx_2_2 core_tx_2_2(t_2_2, core_to_ni_2_2);
    mock_core_rx<2, 2> core_rx_2_2(ni_to_core_2_2);
    network_interface_prs<2, 8, 2, 2> ni_2_2(core_to_ni_2_2, ni_to_r_2_2, r_to_ni_2_2, ni_to_core_2_2);
    router_prs<2, 8, 2, 2> r_2_2(
        s_2_3_to_2_2, n_2_1_to_2_2, w_3_2_to_2_2, e_1_2_to_2_2, ni_to_r_2_2,
        n_2_2_to_2_3, s_2_2_to_2_1, e_2_2_to_3_2, w_2_2_to_1_2, r_to_ni_2_2
    );

    mock_core_tx_3_2 core_tx_3_2(t_3_2, core_to_ni_3_2);
    mock_core_rx<3, 2> core_rx_3_2(ni_to_core_3_2);
    network_interface_prs<2, 8, 3, 2> ni_3_2(core_to_ni_3_2, ni_to_r_3_2, r_to_ni_3_2, ni_to_core_3_2);
    router_prs<2, 8, 3, 2> r_3_2(
        s_3_3_to_3_2, n_3_1_to_3_2, in_3_2_e, e_2_2_to_3_2, ni_to_r_3_2,
        n_3_2_to_3_3, s_3_2_to_3_1, out_3_2_e, w_3_2_to_2_2, r_to_ni_3_2
    );

    mock_core_tx_0_3 core_tx_0_3(t_0_3, core_to_ni_0_3);
    mock_core_rx<0, 3> core_rx_0_3(ni_to_core_0_3);
    network_interface_prs<2, 8, 0, 3> ni_0_3(core_to_ni_0_3, ni_to_r_0_3, r_to_ni_0_3, ni_to_core_0_3);
    router_prs<2, 8, 0, 3> r_0_3(
        in_0_3_n, n_0_2_to_0_3, w_1_3_to_0_3, in_0_3_w, ni_to_r_0_3,
        out_0_3_n, s_0_3_to_0_2, e_0_3_to_1_3, out_0_3_w, r_to_ni_0_3
    );

    mock_core_tx_1_3 core_tx_1_3(t_1_3, core_to_ni_1_3);
    mock_core_rx<1, 3> core_rx_1_3(ni_to_core_1_3);
    network_interface_prs<2, 8, 1, 3> ni_1_3(core_to_ni_1_3, ni_to_r_1_3, r_to_ni_1_3, ni_to_core_1_3);
    router_prs<2, 8, 1, 3> r_1_3(
        in_1_3_n, n_1_2_to_1_3, w_2_3_to_1_3, e_0_3_to_1_3, ni_to_r_1_3,
        out_1_3_n, s_1_3_to_1_2, e_1_3_to_2_3, w_1_3_to_0_3, r_to_ni_1_3
    );

    mock_core_tx_2_3 core_tx_2_3(t_2_3, core_to_ni_2_3);
    mock_core_rx<2, 3> core_rx_2_3(ni_to_core_2_3);
    network_interface_prs<2, 8, 2, 3> ni_2_3(core_to_ni_2_3, ni_to_r_2_3, r_to_ni_2_3, ni_to_core_2_3);
    router_prs<2, 8, 2, 3> r_2_3(
        in_2_3_n, n_2_2_to_2_3, w_3_3_to_2_3, e_1_3_to_2_3, ni_to_r_2_3,
        out_2_3_n, s_2_3_to_2_2, e_2_3_to_3_3, w_2_3_to_1_3, r_to_ni_2_3
    );

    mock_core_tx_3_3 core_tx_3_3(t_3_3, core_to_ni_3_3);
    mock_core_rx<3, 3> core_rx_3_3(ni_to_core_3_3);
    network_interface_prs<2, 8, 3, 3> ni_3_3(core_to_ni_3_3, ni_to_r_3_3, r_to_ni_3_3, ni_to_core_3_3);
    router_prs<2, 8, 3, 3> r_3_3(
        in_3_3_n, n_3_2_to_3_3, in_3_3_e, e_2_3_to_3_3, ni_to_r_3_3,
        out_3_3_n, s_3_3_to_3_2, out_3_3_e, w_3_3_to_2_3, r_to_ni_3_3
    );

    route_sink_prs<2, 8> sk_s_0(out_0_0_s);
    route_sink_prs<2, 8> sk_n_0(out_0_3_n);
    route_sink_prs<2, 8> sk_s_1(out_1_0_s);
    route_sink_prs<2, 8> sk_n_1(out_1_3_n);
    route_sink_prs<2, 8> sk_s_2(out_2_0_s);
    route_sink_prs<2, 8> sk_n_2(out_2_3_n);
    route_sink_prs<2, 8> sk_s_3(out_3_0_s);
    route_sink_prs<2, 8> sk_n_3(out_3_3_n);
    route_sink_prs<2, 8> sk_w_0(out_0_0_w);
    route_sink_prs<2, 8> sk_e_0(out_3_0_e);
    route_sink_prs<2, 8> sk_w_1(out_0_1_w);
    route_sink_prs<2, 8> sk_e_1(out_3_1_e);
    route_sink_prs<2, 8> sk_w_2(out_0_2_w);
    route_sink_prs<2, 8> sk_e_2(out_3_2_e);
    route_sink_prs<2, 8> sk_w_3(out_0_3_w);
    route_sink_prs<2, 8> sk_e_3(out_3_3_e);

    null_source_prs<2, 8> ns_s_0(in_0_0_s);
    null_source_prs<2, 8> ns_n_0(in_0_3_n);
    null_source_prs<2, 8> ns_s_1(in_1_0_s);
    null_source_prs<2, 8> ns_n_1(in_1_3_n);
    null_source_prs<2, 8> ns_s_2(in_2_0_s);
    null_source_prs<2, 8> ns_n_2(in_2_3_n);
    null_source_prs<2, 8> ns_s_3(in_3_0_s);
    null_source_prs<2, 8> ns_n_3(in_3_3_n);
    null_source_prs<2, 8> ns_w_0(in_0_0_w);
    null_source_prs<2, 8> ns_e_0(in_3_0_e);
    null_source_prs<2, 8> ns_w_1(in_0_1_w);
    null_source_prs<2, 8> ns_e_1(in_3_1_e);
    null_source_prs<2, 8> ns_w_2(in_0_2_w);
    null_source_prs<2, 8> ns_e_2(in_3_2_e);
    null_source_prs<2, 8> ns_w_3(in_0_3_w);
    null_source_prs<2, 8> ns_e_3(in_3_3_e);

    chp {
        log("--- STARTING MESH SIMULATION ---");
        t_0_0!1,
        t_1_0!1,
        t_2_0!1,
        t_3_0!1,
        t_0_1!1,
        t_1_1!1,
        t_2_1!1,
        t_3_1!1,
        t_0_2!1,
        t_1_2!1,
        t_2_2!1,
        t_3_2!1,
        t_0_3!1,
        t_1_3!1,
        t_2_3!1,
        t_3_3!1 // Last trigger (No comma)
    }
}

