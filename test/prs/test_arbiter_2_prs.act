// test_arbiter_2_prs.act - testbench with PRS data path, CHP control

import "src/prs/arbiter_2_prs.act";
import globals;

// ---------------------------------------------------------
// PRS ACK
// ---------------------------------------------------------
template <pint ML, DW>
defproc prs_ack (pkt_chan?<ML, DW> ch) {
    prs {
        ~Reset & ch.r => ch.a+
    }
}

// ---------------------------------------------------------
// TXN OBSERVER
// ---------------------------------------------------------
defproc txn_observer (bool? a; chan!(int<1>) done) {
    chp {
        [ a ];
        log("  Txn ack rising (out.a -> 1)");
        done!1;
        [ ~a ];
        log("  Txn ack falling (out.a -> 0)");
        done!1
    }
}

// ---------------------------------------------------------
// CONTROLLER
// ---------------------------------------------------------
template <pint ML, DW>
defproc test_ctrl (pkt_chan!<ML, DW> c1, c2; chan?(int<1>) done) {
    int<1> d;
    chp {
        log("TEST 1: c1 sends 0x11");
        c1!0x11;
        done?d;
        log("TEST 2: c2 sends 0x22");
        c2!0xFF;
        done?d;
        log("All tests complete.")
    }
}

defproc test_arbiter_2_prs () {
    pkt_chan<2, 8> c1, c2, c_out;
    chan(int<1>) done;

    arbiter_2_prs<2, 8> dut(c1, c2, c_out);
    prs_ack<2, 8> ack(c_out);
    txn_observer obs(c_out.a, done);
    test_ctrl<2, 8> ctrl(c1, c2, done);
}

// Initialize: pulse global Reset high then low.
Initialize {
    actions { Reset+ };
    actions { Reset- }
}