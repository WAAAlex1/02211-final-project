// test_input_block.act - Unit test for the 2-phase PRS input block (I + R).
//
// DUT: input_block at X=1, Y=1. MESH_LENGTH=2, DATA_WIDTH=8. Packet=14 bits.

import "src/prs/input_block.act";
import globals;

// ---------------------------------------------------------
// PRS AUTO-ACK - Directly mirrors ch.r back to ch.a. 
// ---------------------------------------------------------
template <pint ML, DW>
defproc prs_ack (pkt_chan?<ML, DW> ch) {
    prs {
         ch.r & ~ch.a -> ch.a+
        ~ch.r &  ch.a -> ch.a-
    }
}

// ---------------------------------------------------------
// CONTROLLER
// ---------------------------------------------------------
template <pint ML, DW>
defproc test_input_block_ctrl (pkt_chan!<ML, DW> in_c) {
    pint W = 2*ML + 2 + DW;
    int<W> pkt;
    chp {
        log("TEST 1: Expecting EAST...");
        in_c!0x22AA;
        log("TEST 2: Expecting SOUTH...");
        in_c!0x10BB;
        log("TEST 3: Expecting LOCAL...");
        in_c!0x14CC;
        log("TEST 4: Expecting SOUTH...");
        in_c!0x1ADD;
        log("TEST 5: Expecting WEST...");
        in_c!0x00EE;
        log("Input block PRS tests complete.")
    }
}

// ---------------------------------------------------------
// TOP LEVEL
// ---------------------------------------------------------
defproc test_input_block () {
    pkt_chan<2, 8> in_c, out_N, out_S, out_E, out_W, out_L;

    input_block<2, 8, 1, 1> dut(in_c, out_N, out_S, out_E, out_W, out_L);

    prs_ack<2, 8> ack_N(out_N);
    prs_ack<2, 8> ack_S(out_S);
    prs_ack<2, 8> ack_E(out_E);
    prs_ack<2, 8> ack_W(out_W);
    prs_ack<2, 8> ack_L(out_L);

    test_input_block_ctrl<2, 8> ctrl(in_c);
}

Initialize {
    actions { Reset+ };
    actions { Reset- }
}
