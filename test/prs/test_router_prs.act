// test_router_prs.act - Top-level unit test for the 2-phase PRS 5-port router
//
// DUT: router_prs at X=1, Y=1. MESH_LENGTH=2, DATA_WIDTH=8. Packet=14 bits.
//
// Packet layout: x_dest[13:12], y_dest[11:10], x_dir[9], y_dir[8], payload[7:0]
//
// Coverage:
//   - Every input port (N,S,E,W,L) used at least once.
//   - Every output port (N,S,E,W,L) hit at least once.
//   - 2x Collision cases (2 and 4 directions)

import "src/prs/router_prs.act";
import globals;

// ---------------------------------------------------------
// RECEIVER 
// ---------------------------------------------------------
template <pint MESH_LENGTH, DATA_WIDTH, PORT_ID>
defproc mock_prs_router_rx (
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in_chan;
    chan!(int<1>) done
) {
    pint W = 2*MESH_LENGTH + 2 + DATA_WIDTH;
    int<W> pkt;
    chp {
        *[
            in_chan?pkt;
            [ PORT_ID = 1 -> log("  [OUT N] Data:", pkt{7..0})
            [] PORT_ID = 2 -> log("  [OUT S] Data:", pkt{7..0})
            [] PORT_ID = 3 -> log("  [OUT E] Data:", pkt{7..0})
            [] PORT_ID = 4 -> log("  [OUT W] Data:", pkt{7..0})
            [] PORT_ID = 5 -> log("  [OUT L] Data:", pkt{7..0})
            ];
            done!1
        ]
    }
}

// ---------------------------------------------------------
// RECEIVER
// ---------------------------------------------------------
template <pint MESH_LENGTH, DATA_WIDTH, PORT_ID>
defproc mock_prs_router_rx_nodone (
    pkt_chan?<MESH_LENGTH, DATA_WIDTH> in_chan
) {
    pint W = 2*MESH_LENGTH + 2 + DATA_WIDTH;
    int<W> pkt;
    chp {
        *[
            in_chan?pkt;
            [ PORT_ID = 1 -> log("  [OUT N] Data:", pkt{7..0})
            [] PORT_ID = 2 -> log("  [OUT S] Data:", pkt{7..0})
            [] PORT_ID = 3 -> log("  [OUT E] Data:", pkt{7..0})
            [] PORT_ID = 4 -> log("  [OUT W] Data:", pkt{7..0})
            [] PORT_ID = 5 -> log("  [OUT L] Data:", pkt{7..0})
            ]
        ]
    }
}

// ---------------------------------------------------------
// CONTROLLER
// ---------------------------------------------------------
defproc test_router_prs_ctrl (
    pkt_chan!<2, 8> in_N, in_S, in_E, in_W, in_L;
    chan?(int<1>) done_N, done_S, done_E, done_W
) {
    int<1> d;
    chp {
        log("=== TEST 1: West -> East - Data:0xAA ===");
        in_W!0x26AA;
        done_E?d;

        log("=== TEST 2: North -> South - Data:0x11 ===");
        in_N!0x1011;
        done_S?d;

        log("=== TEST 3: East -> West - Data:0x22  ===");
        in_E!0x0422;
        done_W?d;

        log("=== TEST 4: South -> Local - Data:0xCC  ===");
        in_S!0x14CC;

        log("=== TEST 5: Local -> North - Data:0xDD ===");
        in_L!0x19DD;
        done_N?d;

        log("=== TEST 6: W (0xAA) and N (0xBB) go to East ===");
        in_W!0x26AA, in_N!0x22BB, done_E?d;
        done_E?d;

        log("=== TEST 7: 4-way contention to Local - N(0x01),S(0x02),E(0x03),W(0x04) ===");
        in_N!0x1401, in_S!0x1402, in_E!0x1403, in_W!0x1404;

        log("=== All Router PRS tests complete! ===")
    }
}

// ---------------------------------------------------------
// TOP LEVEL
// ---------------------------------------------------------
defproc test_router_prs () {
    pkt_chan<2, 8> in_N, in_S, in_E, in_W, in_L;
    pkt_chan<2, 8> out_N, out_S, out_E, out_W, out_L;
    chan(int<1>)   done_N, done_S, done_E, done_W;

    router_prs<2, 8, 1, 1> dut(
        in_N, in_S, in_E, in_W, in_L,
        out_N, out_S, out_E, out_W, out_L
    );

    mock_prs_router_rx<2, 8, 1> rx_N(out_N, done_N);
    mock_prs_router_rx<2, 8, 2> rx_S(out_S, done_S);
    mock_prs_router_rx<2, 8, 3> rx_E(out_E, done_E);
    mock_prs_router_rx<2, 8, 4> rx_W(out_W, done_W);
    mock_prs_router_rx_nodone<2, 8, 5> rx_L(out_L); //special case to test 4-way conflict

    test_router_prs_ctrl ctrl(
        in_N, in_S, in_E, in_W, in_L,
        done_N, done_S, done_E, done_W
    );
}

Initialize {
    actions { Reset+ };
    actions { Reset- }
}