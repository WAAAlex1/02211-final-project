d// test_arbiter_4_prs.act - Testbench for the 2-phase 4-way Arbiter Tree
//
// MESH_LENGTH=2, DATA_WIDTH=8. Packet=14 bits.
//
// pkt_chan<M,D> inherits from chan(int<2M+2+D>), so CHP processes declare
// ports as chan(int<W>) and the top-level pkt_chan wiring is valid via subtyping.

import "src/prs/arbiter_4_prs.act";

// ---------------------------------------------------------
// MOCK SENDER
// ---------------------------------------------------------
template <pint MESH_LENGTH, DATA_WIDTH, val>
defproc mock_prs_sender (chan?(int<1>) trigger; chan!(int<2*MESH_LENGTH + 2 + DATA_WIDTH>) out_chan) {
    int<1> t;
    chp {
        *[
            trigger?t;
            out_chan!val
        ]
    }
}

// ---------------------------------------------------------
// MOCK RECEIVER
// ---------------------------------------------------------
template <pint MESH_LENGTH, DATA_WIDTH>
defproc mock_prs_arb_receiver (chan?(int<2*MESH_LENGTH + 2 + DATA_WIDTH>) in_chan) {
    pint W = 2*MESH_LENGTH + 2 + DATA_WIDTH;
    int<W> pkt;
    int<8> data;
    chp {
        *[
            in_chan?pkt;
            data := pkt{7..0};
            log("  Arbiter output: data=", data)
        ]
    }
}

// ---------------------------------------------------------
// TEST CONTROLLER
// ---------------------------------------------------------
defproc test_arbiter_4_prs_ctrl (
    chan!(int<1>) t1, t2, t3, t4
) {
    chp {
        // TEST 1: Single Request on Port 1
        log("TEST 1 (Single Request Port 1) - Expecting data=0x11:");
        t1!1;

        // TEST 2: Single Request on Port 3
        log("TEST 2 (Single Request Port 3) - Expecting data=0x33:");
        t3!1;

        // TEST 3: Contention (Port 2 vs Port 4 simultaneously)
        log("TEST 3 (Double request - Port 2 vs Port 4):");
        t2!1;
        t4!1;

        log("All Arbiter PRS test cases fired!")
    }
}

// ---------------------------------------------------------
// TOP LEVEL
// ---------------------------------------------------------
defproc test_arbiter_4_prs () {
    pkt_chan<2, 8> c1, c2, c3, c4, c_out;
    chan(int<1>)   t1, t2, t3, t4;

    arbiter_4_prs<2, 8> dut(c1, c2, c3, c4, c_out);

    mock_prs_sender<2, 8, 0x11> sender1(t1, c1);
    mock_prs_sender<2, 8, 0x22> sender2(t2, c2);
    mock_prs_sender<2, 8, 0x33> sender3(t3, c3);
    mock_prs_sender<2, 8, 0x44> sender4(t4, c4);

    mock_prs_arb_receiver<2, 8> rx(c_out);

    test_arbiter_4_prs_ctrl ctrl(t1, t2, t3, t4);
}
