# Actsim script - arbiter_4_prs
#
# Watches just c_out.r (one transition per packet) and the final-stage
# grants (who actually wins the 4-way arbitration). Intermediate top/bot
# level grants are implementation churn — uncomment if you need them.

#random -u 10 20
#random_seed 1
#random_choice on

#watch c_out.r
#watch dut.arb_final.g1
#watch dut.arb_final.g2

# Intermediate grants (uncomment to debug):
# watch dut.arb_top.g1
# watch dut.arb_top.g2
# watch dut.arb_bot.g1
# watch dut.arb_bot.g2

cycle
quit
